% =====================================================================
% adobe-techreport.sty
% A lightweight Adobe-branded technical-report style.
%
% There is NO official public Adobe LaTeX class. This package builds an
% Adobe-styled report on the standard `article' class, using:
%   * Adobe's own open-source Source fonts (the sanctioned public
%     stand-ins for the proprietary Adobe Clean face):
%       - Source Serif Pro  (body)      -- OFL-1.1, Frank Griesshammer / Adobe
%       - Source Sans  Pro  (headings)  -- OFL-1.1, Paul D. Hunt / Adobe (2012)
%       - Source Code  Pro  (mono)      -- OFL-1.1, Adobe
%   * Adobe corporate red  #FA0F00.
%
% Engine: pdfLaTeX (portable; fonts come from the CTAN packages). Compiles
% unchanged under LuaLaTeX/XeLaTeX (the Source packages auto-select OTF).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{adobe-techreport}[2026/07/23 Adobe-styled technical report]

% ---- fonts (Adobe open-source Source family) ------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage{sourceserifpro}            % body: Source Serif Pro
\RequirePackage[semibold]{sourcesanspro}   % headings/display: Source Sans Pro
\RequirePackage{sourcecodepro}             % code: Source Code Pro
\RequirePackage{microtype}

% ---- brand colours --------------------------------------------------
\RequirePackage{xcolor}
\definecolor{adobered}{HTML}{FA0F00}       % current Adobe corporate red
\definecolor{adobeink}{HTML}{1A1A1A}       % near-black ink for text
\definecolor{adobegray}{HTML}{6E6E6E}      % secondary / captions

% ---- page geometry --------------------------------------------------
\RequirePackage[margin=1in]{geometry}
\RequirePackage{setspace}
\setstretch{1.04}

% ---- maths / graphics / tables --------------------------------------
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=3pt,parsep=0pt}

% ---- code listings --------------------------------------------------
\RequirePackage{listings}
\lstset{
  basicstyle=\footnotesize\ttfamily,
  keywordstyle=\color{adobered}\bfseries,
  commentstyle=\color{adobegray}\itshape,
  stringstyle=\color{adobeink},
  breaklines=true,
  columns=fullflexible,
  showstringspaces=false,
  frame=leftline,
  rulecolor=\color{adobered},
  framesep=6pt,
  xleftmargin=8pt,
}

% ---- section heading style (sans, red-accented numbers) -------------
\RequirePackage{titlesec}
\titleformat{\section}
  {\sffamily\Large\bfseries\color{adobeink}}
  {\color{adobered}\thesection}{0.6em}{}
\titleformat{\subsection}
  {\sffamily\large\bfseries\color{adobeink}}
  {\color{adobered}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{adobeink}}
  {\color{adobered}\thesubsubsection}{0.5em}{}

% ---- bibliography / citations ---------------------------------------
% `plainnat' emits natbib-style \bibitem labels, so natbib MUST be loaded
% or plain \cite prints the raw [short(year)long-author-list] label (which
% overflows narrow columns). Numeric + sort&compress keeps citations compact
% (e.g. [3,7--9]) -- appropriate for a citation-dense technical report.
% natbib is loaded before hyperref so citation hyperlinks resolve correctly.
\RequirePackage[numbers,sort&compress]{natbib}

% ---- hyperlinks -----------------------------------------------------
\RequirePackage[colorlinks=true,linkcolor=adobered,urlcolor=adobered,
                citecolor=adobered,breaklinks=true]{hyperref}
\RequirePackage{cleveref}

% ---- callout / note box (for TODO / placeholder markers) ------------
\RequirePackage[most]{tcolorbox}
\newtcolorbox{placeholder}[1][]{
  colback=adobered!4, colframe=adobered, boxrule=0.6pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,
  fonttitle=\sffamily\bfseries\color{adobered},
  title={Placeholder --- to be completed}, #1}
\newtcolorbox{notebox}[1][]{
  colback=black!3, colframe=adobegray, boxrule=0.5pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt, #1}

% ---- implementation-status badges -----------------------------------
% Consistent, colour-coded status tags so a reader can never mistake an
% architectural description for an empirical claim.
\newcommand{\statusbadge}[2]{{\sffamily\bfseries\footnotesize
  \setlength{\fboxsep}{2pt}\colorbox{#1}{\textcolor{white}{\,#2\,}}}}
\newcommand{\built}{\statusbadge{adobeink}{BUILT}}
\newcommand{\partialb}{\statusbadge{adobegray}{PARTIAL}}
\newcommand{\stub}{\statusbadge{adobegray}{STUB}}
\newcommand{\notintegrated}{\statusbadge{adobegray}{NOT INTEGRATED}}
\newcommand{\proposed}{\statusbadge{adobered}{PROPOSED}}
\newcommand{\invalidated}{\statusbadge{adobered}{RESULT INVALIDATED}}

% ---- status / scope box (front matter) ------------------------------
\newtcolorbox{scopebox}[1][]{
  colback=adobered!5, colframe=adobered, boxrule=1pt,
  left=8pt,right=8pt,top=6pt,bottom=6pt, arc=2pt,
  fonttitle=\sffamily\bfseries\color{white},
  coltitle=white, colbacktitle=adobered,
  title={REPORT STATUS AND SCOPE}, #1}

% ---- Adobe-style title block ----------------------------------------
% Usage: \reporttitle, \reportsubtitle, \reportauthor, \reportdate,
%        \reportnumber, then \makeadobetitle.
\newcommand{\reporttitle}[1]{\def\@reporttitle{#1}}
\newcommand{\reportsubtitle}[1]{\def\@reportsubtitle{#1}}
\newcommand{\reportauthor}[1]{\def\@reportauthor{#1}}
\newcommand{\reportdate}[1]{\def\@reportdate{#1}}
\newcommand{\reportnumber}[1]{\def\@reportnumber{#1}}
\reporttitle{Untitled Report}
\reportsubtitle{}
\reportauthor{Adobe Research}
\reportdate{\today}
\reportnumber{}

\newcommand{\makeadobetitle}{%
  \begingroup
  \setlength{\parindent}{0pt}%
  {\color{adobered}\rule{\linewidth}{3pt}}\par\vspace{2pt}
  {\sffamily\bfseries\footnotesize\color{adobered}%
     ADOBE TECHNICAL REPORT\ifx\@reportnumber\empty\else\ \textcolor{adobegray}{\textbar\ \@reportnumber}\fi\par}
  \vspace{10pt}
  {\sffamily\bfseries\Huge\color{adobeink}\@reporttitle\par}
  \ifx\@reportsubtitle\empty\else
    \vspace{5pt}{\sffamily\large\color{adobegray}\@reportsubtitle\par}
  \fi
  \vspace{10pt}
  {\sffamily\normalsize\color{adobeink}\@reportauthor\par}
  \vspace{2pt}
  {\sffamily\small\color{adobegray}\@reportdate\par}
  \vspace{4pt}
  {\color{adobeink}\rule{\linewidth}{0.6pt}}\par
  \vspace{14pt}
  \endgroup}

\endinput
